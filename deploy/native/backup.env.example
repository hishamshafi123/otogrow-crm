# The key is32 raw bytes in a separate root-owned0600 file. Never put the key
# in this file, the repository, a backup directory or the offsite destination.
BACKUP_KEY_FILE=/etc/otogrow-crm/backup.key
BACKUP_DIR=/var/backups/otogrow-crm
BACKUP_RETENTION_DAYS=14
BACKUP_EXPECTED_DATABASE=crm
BACKUP_STORAGE_PATH=/var/lib/otogrow-crm/storage
BACKUP_CONFIG_PATH=/etc/otogrow-crm/crm.env
# Required: database/media consistency needs a brief API+worker maintenance window.
BACKUP_QUIESCE=yes
