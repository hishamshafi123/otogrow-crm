[Unit]
Description=Encrypted Otogrow CRM database, media and recovery-configuration backup
After=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/otogrow-crm/crm.env
EnvironmentFile=/etc/otogrow-crm/backup.env
UMask=0077
ExecStart=/usr/bin/flock --nonblock /run/lock/otogrow-crm-deploy.lock /usr/bin/flock --wait 1800 /run/lock/otogrow-crm-backup.lock /opt/nodejs/24/bin/node /usr/local/lib/otogrow-crm/backup.mjs create
# A terminated backup must not leave this app in its maintenance window.
ExecStopPost=/usr/bin/flock --wait 80 /run/lock/otogrow-crm-backup.lock /opt/nodejs/24/bin/node /usr/local/lib/otogrow-crm/backup.mjs resume
TimeoutStartSec=3600
TimeoutStopSec=90
MemoryHigh=384M
MemoryMax=512M
CPUWeight=20
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/otogrow-crm /run/lock/otogrow-crm-deploy.lock /run/lock/otogrow-crm-backup.lock
CacheDirectory=otogrow-crm-backup
CacheDirectoryMode=0700
