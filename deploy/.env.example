# ==========================================================================
# Otogrow CRM — production environment (copy to .env on the VPS, chmod 600)
# ==========================================================================

# Public origin of the app. Caddy terminates TLS for this host; the server
# builds absolute URLs (emails, file links, portal links) from it.
SERVER_URL=https://crm.otogrow.com

# Generate on the VPS with: openssl rand -base64 32
# Signs sessions and tokens. Never commit a real value; if it rotates, all
# sessions and file tokens are invalidated.
APP_SECRET=REPLACE_ME_run_openssl_rand_base64_32

# Optional but recommended: dedicated key for at-rest encryption of stored
# secrets (e.g. Twilio auth tokens). Falls back to APP_SECRET when unset.
# Generate a second one: openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_ME_run_openssl_rand_base64_32

# Database (container-internal only; the db port is NOT published publicly)
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=REPLACE_ME_choose_a_long_random_password
PG_DATABASE_NAME=default

# Used as the image's APP_VERSION label/arg; bump when you deploy a new build.
APP_VERSION=1.0.0

# --------------------------------------------------------------------------
# Behaviour flags (safe defaults for this deployment — no action needed)
# --------------------------------------------------------------------------
# Local disk storage inside the app-storage docker volume; covered by backup.sh
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=.local-storage

# New-workspace sign-up closes automatically once the first workspace exists
# (sign-in-up.service allows workspace creation only when count = 0). Keep
# this false so nobody else can create a workspace on the public internet.
IS_MULTIWORKSPACE_ENABLED=false
IS_WORKSPACE_CREATION_LIMITED_TO_SERVER_ADMINS=true

# No SMTP yet, so email verification must stay off or the first sign-up would
# stall waiting for a verification email that never arrives.
IS_EMAIL_VERIFICATION_REQUIRED=false

# Do not prefill login credentials in production.
SIGN_IN_PREFILLED=false

# WhatsApp/SMS: LOGGER = messages are written to the server logs instead of
# being sent. Flip to TWILIO once real credentials are configured per
# workspace in Settings (Account SID / auth token live in the database,
# not in env).
TWILIO_DRIVER=LOGGER

# No CAPTCHA on public forms/login for now. To enable Cloudflare Turnstile
# later: CAPTCHA_DRIVER=CLOUDFLARE_TURNSTILE plus the two keys below.
# CAPTCHA_DRIVER=CLOUDFLARE_TURNSTILE
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# --------------------------------------------------------------------------
# SMTP — SKIPPED for the initial deploy. Until these are filled in and
# EMAIL_DRIVER is switched to SMTP, the app cannot send email, which means:
#   - workspace invite emails are not delivered (share the invite link
#     manually from Settings > Members instead)
#   - password-reset emails are not delivered (no self-service reset)
#   - email-verification emails are not sent (verification is disabled above)
# LOGGER mode writes the would-be email bodies to the app container logs
# (docker compose logs app), which is enough to debug.
# --------------------------------------------------------------------------
EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=noreply@otogrow.com
EMAIL_FROM_NAME=Otogrow CRM
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=

# --------------------------------------------------------------------------
# Backup script settings (used by backup.sh / restore.sh, not by the app)
# --------------------------------------------------------------------------
# Where dumps are written on the VPS
BACKUP_DIR=/opt/otogrow/backups
# Days of local retention
BACKUP_RETENTION_DAYS=14

# --------------------------------------------------------------------------
# Disk alert (disk-alert.sh): healthchecks.io-style ping URL that receives a
# request only when disk usage exceeds DISK_ALERT_THRESHOLD percent.
# --------------------------------------------------------------------------
# DISK_ALERT_PING_URL=https://hc-ping.com/your-uuid-here
DISK_ALERT_THRESHOLD=80
